[Unit]
Description=Omni Medical Suite - Main Application
Documentation=https://github.com/DrAbdulmalek/omni-medical-suite
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/omni-medical-suite
Environment="PATH=%h/omni-medical-suite/venv/bin:/usr/bin"
Environment="PYTHONPATH=%h/omni-medical-suite"
Environment="TESSDATA_PREFIX=/usr/share/tessdata"
ExecStart=%h/omni-medical-suite/venv/bin/python -m app.advanced_review_app
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target